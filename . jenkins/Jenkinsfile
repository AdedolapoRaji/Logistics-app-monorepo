pipeline {
    agent any

    environment {
        DOCKER_REGISTRY_USER = 'adedolapo05'
        // This links directly to your Jenkins credentials provider block ID
        DOCKER_CREDENTIALS_ID = 'dockerhub-credentials' 
    }

    stages {
        stage('Checkout Source') {
            steps {
                // Pulls down your latest monorepo structure from GitHub
                checkout scm
            }
        }

        stage('Build & Containerize Services') {
            steps {
                script {
                    // Defined all 5 components of your monorepo architecture
                    def services = [
                        'order-service', 
                        'driver-service', 
                        'notification-service', 
                        'tracking-service', 
                        'frontend'
                    ]
                    
                    // Securely open a connection context with Docker Hub
                    withCredentials([string(credentialsId: env.DOCKER_CREDENTIALS_ID, variable: 'DOCKER_TOKEN')]) {
                        sh "echo \$DOCKER_TOKEN | docker login -u ${env.DOCKER_REGISTRY_USER} --password-stdin"
                        
                        for (service in services) {
                            echo "--------------------------------------------------------"
                            echo "Processing Service Layer: ${service.toUpperCase()}"
                            echo "--------------------------------------------------------"
                            
                            // Condition block: Only compile using Maven if it's a backend Java app
                            if (service != 'frontend') {
                                dir("${service}") {
                                    sh "mvn clean package -DskipTests"
                                }
                            }
                            
                            // Build and push the container images for everything including the frontend
                            dir("${service}") {
                                sh "docker build -t ${env.DOCKER_REGISTRY_USER}/${service}:${BUILD_NUMBER} ."
                                sh "docker push ${env.DOCKER_REGISTRY_USER}/${service}:${BUILD_NUMBER}"
                            }
                        }
                    }
                }
            }
        }

        stage('Trigger CD Deployment') {
            steps {
                echo "Synchronizing downstream build pipeline hooks..."
                // Pass the unique execution build integer to your continuous delivery pipeline
                build job: 'logistics-cd-pipeline', parameters: [
                    string(name: 'BUILD_NUM', value: "${BUILD_NUMBER}")
                ], wait: false
            }
        }
    }

    post {
        always {
            echo "Pipeline clearing active build processes... Finished execution."
            sh "docker logout"
        }
    }
}
