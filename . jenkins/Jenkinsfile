pipeline {
    agent any
    environment {
        DOCKER_REGISTRY = 'adedolapo05'
        REGISTRY_CREDENTIALS_ID = 'dockerhub-token'
    }
    stages {
        stage('Source Inspection') {
            steps {
                echo 'Checking Repository Layout...'
                checkout scm
            }
        }
        stage('Build & Test Services') {
            steps {
                dir('order-service') {
                    sh 'mvn clean test'
                }
            }
        }
        stage('Containerize Architecture') {
            steps {
                // This correctly binds your 'Secret text' token to an environment variable
                withCredentials([string(credentialsId: "${REGISTRY_CREDENTIALS_ID}", variable: 'DOCKER_TOKEN')]) {
                    // Log in using your hardcoded username and the secure token variable
                    sh "echo \$DOCKER_TOKEN | docker login -u ${DOCKER_REGISTRY} --password-stdin"
                    
                    echo "Building Docker Image..."
                    sh "docker build -t ${DOCKER_REGISTRY}/order-service:${BUILD_NUMBER} ./order-service"
                    
                    echo "Pushing Image to Docker Hub..."
                    sh "docker push ${DOCKER_REGISTRY}/order-service:${BUILD_NUMBER}"
                }
            }
        }
        stage('Trigger Deployment') {
            steps {
                build job: 'logistics-cd-pipeline', parameters: [
                    string(name: 'BUILD_NUM', value: "${BUILD_NUMBER}")
                ]
            }
        }
    }
}
