pipeline {
    agent any
    parameters {
        string(name: 'BUILD_NUM', description: 'Target image version tag to roll out')
    }
    stages {
        stage('Checkout Source') {
            steps {
                // Pulls down the repository so Jenkins can find your docker-compose.yml file
                checkout scm
            }
        }
        stage('Deploy All Services with Compose') {
            steps {
                // This passes Jenkins's BUILD_NUM to the docker-compose file
                withEnv(["BUILD_NUM=${params.BUILD_NUM}"]) {
                    echo "Deploying logistics stack version ${env.BUILD_NUM} via Docker Compose..."
                    
                    // 1. Pull the fresh images from Docker Hub that match the build number
                    sh "docker-compose pull"
                    
                    // 2. Stop old containers and start the new ones instantly
                    sh "docker-compose up -d"
                    
                    echo "All microservices successfully orchestrated!"
                }
            }
        }
    }
}
