pipeline {
    agent any
    parameters {
        string(name: 'BUILD_NUM', description: 'Target image version tag to roll out')
    }
    environment {
        DOCKER_REGISTRY = 'adedolapo05'
    }
    stages {
        stage('Deploy All Services') {
            steps {
                script {
                    def services = [
                        'order-service': '5001',
                        'driver-service': '5002',
                        'tracking-service': '5003',
                        'notification-service': '5004'
                    ]
                    
                    services.each { serviceName, port ->
                        echo "--------------------------------------------------------"
                        echo "Deploying ${serviceName} (Version: ${params.BUILD_NUM}) on Port: ${port}"
                        echo "--------------------------------------------------------"
                        
                        sh "docker pull ${DOCKER_REGISTRY}/${serviceName}:${params.BUILD_NUM}"
                        sh "docker stop ${serviceName} || true"
                        sh "docker rm ${serviceName} || true"
                        sh "docker run -d --name ${serviceName} -p ${port}:${port} ${DOCKER_REGISTRY}/${serviceName}:${params.BUILD_NUM}"
                    }
                    echo "All 4 microservices have been successfully deployed via SCM!"
                }
            }
        }
    }
}
